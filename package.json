{
    "name": "mediamate",
    "version": "2.0.0",
    "description": "Personal CLI to clean up and organize a media library (names, tags, artwork, timestamps, folder icons).",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "node src/cli/index.js",
        "test": "node --test",
        "format": "prettier --write \".\""
    },
    "engines": {
        "node": ">=20"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.9.0",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@inquirer/prompts": "^8.5.2",
        "dotenv": "^18.0.9",
        "kleur": "^4.1.5",
        "ora": "^9.4.1",
        "prettier": "^3.9.10"
    },
    "bin": {
        "mediamate": "src/cli/index.js",
        "mm": "src/cli/index.js"
    }
}
